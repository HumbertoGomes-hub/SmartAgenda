# Copie para .env e preencha. O .env nunca vai para o Git (ver .gitignore).

# Texto longo e aleatório que assina o cookie de sessão do painel.
# Em produção precisa ter pelo menos 32 caracteres.
SESSION_SECRET=

# Supabase: Project Settings > API
SUPABASE_URL=https://swkkqeoypppdwkupebyd.supabase.co
# Chave secreta (service_role). Dá acesso total ao banco: só no servidor.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=portfolio

# Opcionais
PORT=3000
NODE_ENV=development
TZ=America/Sao_Paulo
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
